# ---- Caspian (required) ----
# One API key covers email + Discord + Telegram free tiers.
CASPIAN_API_KEY=

# Optional override (defaults to https://api.trycaspianai.com).
# CASPIAN_BASE_URL=

# ---- Discord bot (optional, for the demo) ----
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ALERT_CHANNEL_ID=

# ---- Telegram bot (optional, for the demo) ----
TELEGRAM_BOT_TOKEN=

# ---- LLM (optional; agent falls back to templates if absent) ----
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- Disaster data sources ----
USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
NWS_API_BASE=https://api.weather.gov

# ---- Polling ----
POLL_INTERVAL_SEC=120
DEDUP_WINDOW_MIN=30

# ---- Storage ----
AEGIS_DB_PATH=./data/aegis.db

# ---- Logging ----
LOG_LEVEL=info
NODE_ENV=development
